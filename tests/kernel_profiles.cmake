function(check_profile name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${PADRA_SOURCE}" -B "${PADRA_TEST_BINARY}/${name}"
    -G "${PADRA_TEST_GENERATOR}" "-DCMAKE_CXX_COMPILER=${PADRA_TEST_COMPILER}"
    -DPADRA_ENABLE_CUDA=OFF -DPADRA_ENABLE_NATIVE_TEXT=OFF -DBUILD_TESTING=OFF ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(expected STREQUAL "reject")
    if(result EQUAL 0)
      message(FATAL_ERROR "${name}: unsupported/conflicting profile accepted")
    endif()
  else()
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name}: configuration failed: ${output} ${error}")
    endif()
    file(READ "${PADRA_TEST_BINARY}/${name}/generated/runtime/build_identity.h" identity)
    string(FIND "${identity}" "\"${expected}\"" found)
    if(found LESS 0)
      message(FATAL_ERROR "${name}: expected resolved profile ${expected}: ${identity}")
    endif()
  endif()
endfunction()
check_profile(default baseline-v1)
check_profile(legacy exact-fusions-v1 -DPADRA_EXL3_PREFILL_ASYNC64=ON)
check_profile(named-exact exact-fusions-v1 -DPADRA_KERNEL_PROFILE=exact-fusions-v1)
check_profile(named-baseline baseline-v1 -DPADRA_KERNEL_PROFILE=baseline-v1)
check_profile(unknown reject -DPADRA_KERNEL_PROFILE=unknown)
check_profile(conflict reject -DPADRA_KERNEL_PROFILE=baseline-v1 -DPADRA_EXL3_PREFILL_ASYNC64=ON)
check_profile(prefill-global global-dataflow-v1 -DPADRA_PREFILL_PROFILE=global-dataflow-v1)
check_profile(prefill-unknown reject -DPADRA_PREFILL_PROFILE=unknown)

check_profile(prefill-matrix global-matrix-v1 -DPADRA_PREFILL_PROFILE=global-matrix-v1)
check_profile(prefill-split-removed reject -DPADRA_PREFILL_PROFILE=global-matrix-split-v1)

check_profile(q8-packed packed-chunk-v1 -DPADRA_Q8_PREFILL_PROFILE=packed-chunk-v1)
check_profile(q8-unknown reject -DPADRA_Q8_PREFILL_PROFILE=unknown)

check_profile(exl3-independent async64-v1 -DPADRA_EXL3_PREFILL_TRANSPORT=async64-v1 -DPADRA_KERNEL_PROFILE=baseline-v1)
check_profile(exl3-transport-unknown reject -DPADRA_EXL3_PREFILL_TRANSPORT=unknown)

file(READ "${PADRA_TEST_BINARY}/exl3-independent/generated/runtime/build_identity.h" independent_identity)
if(NOT independent_identity MATCHES "kPadraBuildKernelProfile\\[\\]=\"baseline-v1\"")
  message(FATAL_ERROR "independent EXL3 prefill transport changed the decode profile")
endif()

check_profile(prefill-default global-matrix-v1)
check_profile(q8-default packed-chunk-v1)
check_profile(exl3-default async64-v1)
