include_guard(GLOBAL)

set(PADRA_CUDA_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

macro(padra_add_cuda)
  set(PADRA_CUDA_ARCHITECTURE "auto" CACHE STRING "GPU target: auto (device 0), 61, 86, 120, 120a, or another SM >= 61")
  set(PADRA_CUDA_BACKEND "auto" CACHE STRING "CUDA backend: auto, simt, sm120")
  set_property(CACHE PADRA_CUDA_BACKEND PROPERTY STRINGS auto simt sm120)
  find_package(CUDAToolkit 12.0 REQUIRED)
  set(architecture "${PADRA_CUDA_ARCHITECTURE}")
  if(architecture STREQUAL "auto")
    if(CMAKE_CROSSCOMPILING)
      message(FATAL_ERROR "Cross-compilation requires an explicit PADRA_CUDA_ARCHITECTURE")
    endif()
    # A host-only probe honors CUDA_VISIBLE_DEVICES and queries the same CUDA
    # device 0 used by the engine. No native GPU kernel/toolchain target needed.
    unset(padra_query_exit CACHE)
    unset(padra_query_compiled CACHE)
    try_run(padra_query_exit padra_query_compiled
      SOURCE_FROM_CONTENT padra_gpu_query.cpp
      "#include <cuda_runtime_api.h>\n#include <cstdio>\nint main(){cudaDeviceProp p{};if(cudaGetDeviceProperties(&p,0)!=cudaSuccess)return 1;std::printf(\"%d.%d\",p.major,p.minor);}\n"
      CXX_STANDARD 20 LINK_LIBRARIES CUDA::cudart
      RUN_OUTPUT_STDOUT_VARIABLE capability)
    if(NOT padra_query_compiled OR NOT padra_query_exit EQUAL 0 OR NOT capability MATCHES "^[0-9]+\\.[0-9]+$")
      message(FATAL_ERROR "Cannot detect CUDA device 0; set PADRA_CUDA_ARCHITECTURE explicitly for cross-compilation")
    endif()
    string(REPLACE "." "" architecture "${capability}")
    if(architecture STREQUAL "120")
      set(architecture "120a")
    endif()
  endif()
  if(NOT architecture MATCHES "^[0-9]+a?$")
    message(FATAL_ERROR "PADRA_CUDA_ARCHITECTURE must be one SM number (e.g. 61, 86, 120a) or auto")
  endif()
  string(REGEX REPLACE "a$" "" sm "${architecture}")
  if(sm LESS 61)
    message(FATAL_ERROR "Padra requires SM61 or newer")
  endif()
  set(backend "${PADRA_CUDA_BACKEND}")
  if(backend STREQUAL "auto")
    if(sm EQUAL 120)
      set(backend "sm120")
    else()
      set(backend "simt")
    endif()
  endif()
  if(NOT backend MATCHES "^(simt|sm120)$" OR (backend STREQUAL "sm120" AND NOT sm EQUAL 120))
    message(FATAL_ERROR "Backend must be auto/simt/sm120; sm120 requires target 120 or 120a")
  endif()
  if(PADRA_PASCAL_DP4A_PREFILL AND NOT (sm EQUAL 61 AND backend STREQUAL "simt"))
    message(FATAL_ERROR "PADRA_PASCAL_DP4A_PREFILL requires the SM61 SIMT backend")
  endif()
  # The optimized backend includes architecture-specific FP4/MMA instructions
  # which ptxas rejects for plain sm_120. A numeric Blackwell selection means
  # the accelerated target; the portable SIMT backend can still use plain 120.
  if(backend STREQUAL "sm120" AND architecture STREQUAL "120")
    set(architecture "120a")
  endif()
  if(PADRA_EXL3_PREFILL_ASYNC64 AND NOT backend STREQUAL "sm120")
    message(FATAL_ERROR "PADRA_EXL3_PREFILL_ASYNC64 requires the SM120 backend")
  endif()
  # Diagnose removed targets before CMake's CUDA compiler ABI check tries to
  # compile them. Respect explicit compiler/toolkit selection.
  if(sm LESS 75 AND CUDAToolkit_VERSION VERSION_GREATER_EQUAL 13)
    message(FATAL_ERROR "SM${sm} requires CUDA Toolkit 12.x; CUDA 13 removed compilation for GPUs older than SM75")
  endif()
  if(backend STREQUAL "sm120" AND CUDAToolkit_VERSION VERSION_LESS 12.8)
    message(FATAL_ERROR "The SM120 backend requires CUDA Toolkit 12.8 or newer")
  endif()
  if(NOT CMAKE_CUDA_COMPILER AND NOT DEFINED ENV{CUDACXX})
    set(CMAKE_CUDA_COMPILER "${CUDAToolkit_NVCC_EXECUTABLE}" CACHE FILEPATH "CUDA compiler")
  endif()
  set(CMAKE_CUDA_ARCHITECTURES "${architecture}")
  enable_language(CUDA)
  if(sm LESS 75 AND CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 13)
    message(FATAL_ERROR "SM${sm} requires a CUDA 12.x compiler")
  endif()
  if(backend STREQUAL "sm120")
    if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 12.8)
      message(FATAL_ERROR "The SM120 backend requires CUDA Toolkit 12.8 or newer")
    endif()
    include("${PADRA_CUDA_CMAKE_DIR}/PadraCutlass.cmake")
    padra_add_cutlass()
    target_link_libraries(padra_core PRIVATE Padra::CUTLASS)
    target_sources(padra_core PRIVATE src/cuda/inference.cu src/cuda/cutlass_fp8.cu)
    set(simt 0)
  else()
    target_sources(padra_core PRIVATE src/cuda/inference_simt.cu)
    if(sm EQUAL 61)
      target_link_libraries(padra_core PRIVATE CUDA::cublas)
    endif()
    set(simt 1)
  endif()
  target_link_libraries(padra_core PRIVATE CUDA::cudart)
  target_compile_definitions(padra_core PRIVATE
    MELLUM16_ARCHITECTURE="${architecture}" PADRA_CUDA_SM=${sm}
    PADRA_EXL3_PREFILL_ASYNC64=$<BOOL:${PADRA_EXL3_PREFILL_ASYNC64}>)
  set_target_properties(padra_core PROPERTIES CUDA_ARCHITECTURES "${architecture}" CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_compile_options(padra_core PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:-O3>")
  set(PADRA_BUILD_SIMT "${simt}")
  set(PADRA_BUILD_ARCHITECTURE "${architecture}")
  message(STATUS "Padra GPU target: SM${architecture}; backend: ${backend}")
endmacro()
