include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PadraSourceLock.cmake")

function(padra_add_http)
  set(http_source "${PROJECT_SOURCE_DIR}/third_party/cpp-httplib")
  padra_verify_sources("${http_source}" "${http_source}/SOURCE_LOCK.json" "cpp-httplib")
  add_library(padra_http STATIC "${http_source}/httplib.cpp")
  target_include_directories(padra_http SYSTEM PUBLIC "${http_source}")
  target_compile_definitions(padra_http PRIVATE CPPHTTPLIB_TCP_NODELAY=1)
  target_link_libraries(padra_http PRIVATE Threads::Threads)
  if(WIN32)
    target_link_libraries(padra_http PUBLIC ws2_32)
  endif()
  if(NOT MSVC)
    target_compile_options(padra_http PRIVATE -w)
  endif()
endfunction()
